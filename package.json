{
  "name": "al-hinnawi",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "deploy:check": "tsx src/scripts/deployment-check.ts",
    "create-super-admin": "tsx src/scripts/create-super-admin.ts",
    "reset-password": "tsx src/scripts/reset-password.ts",
    "cleanup:media": "tsx src/scripts/cleanup-orphan-media.ts",
    "worker:media": "tsx src/workers/media-worker.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "latest",
    "@aws-sdk/s3-request-presigner": "latest",
    "@dnd-kit/core": "latest",
    "@dnd-kit/sortable": "latest",
    "@hookform/resolvers": "latest",
    "@radix-ui/react-dialog": "latest",
    "@radix-ui/react-dropdown-menu": "latest",
    "@radix-ui/react-slot": "latest",
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/nodemailer": "latest",
    "@types/pg": "latest",
    "@types/qrcode": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "better-auth": "1.6.23",
    "drizzle-orm": "0.45.2",
    "lucide-react": "latest",
    "next": "16.2.10",
    "nodemailer": "latest",
    "pg": "latest",
    "qrcode": "latest",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "latest",
    "recharts": "latest",
    "sharp": "latest",
    "tsx": "latest",
    "typescript": "5.9.3",
    "tailwindcss": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@axe-core/playwright": "latest",
    "@playwright/test": "latest",
    "drizzle-kit": "latest",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "prettier": "latest",
    "vitest": "latest"
  }
}
