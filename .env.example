# Public application origin. Server configuration, not a secret.
APP_URL=http://localhost:3000
NODE_ENV=development
PORT=3000

# Server-only database credentials.
DATABASE_URL=postgresql://alhinnawi:change-me@localhost:55432/alhinnawi
DATABASE_MIGRATION_URL=
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=5000

# Server-only authentication configuration.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# Server-only SMTP configuration.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURE=false

# Server-only storage credentials. Use local for local development.
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
MEDIA_PUBLIC_BASE_URL=http://localhost:3000/api/media
MEDIA_ROOT=/data/media

IMAGE_MAX_SIZE_MB=20
IMAGE_MAX_PIXELS=268402689
VIDEO_MAX_SIZE_MB=150
ANALYTICS_SESSION_SECRET=
CRON_SECRET=

# Optional first administrator bootstrap values.
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
