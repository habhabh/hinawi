# انسخ هذه الأسماء إلى تبويب Environment Variables في Coolify.
# لا تنسخ هذا الملف إلى ملف يحتوي أسرارًا ولا ترفع الأسرار إلى GitHub.

NODE_ENV=production
PORT=3000
APP_URL=https://YOUR_APP_DOMAIN

# استخدم Internal URL من مورد PostgreSQL في Coolify.
DATABASE_URL=postgresql://USER:PASSWORD@INTERNAL_POSTGRES_HOST:5432/DATABASE
DATABASE_MIGRATION_URL=
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=5000

# ولّد كل قيمة سرية بشكل مستقل: openssl rand -base64 48
BETTER_AUTH_SECRET=GENERATE_A_RANDOM_SECRET
BETTER_AUTH_URL=https://YOUR_APP_DOMAIN
BETTER_AUTH_TRUSTED_ORIGINS=https://YOUR_APP_DOMAIN
ANALYTICS_SESSION_SECRET=GENERATE_A_DIFFERENT_RANDOM_SECRET
CRON_SECRET=GENERATE_A_DIFFERENT_RANDOM_SECRET

# الخيار الأبسط لأول نشر: local مع Persistent Volume على /data/media.
STORAGE_DRIVER=local
MEDIA_ROOT=/data/media
MEDIA_PUBLIC_BASE_URL=https://YOUR_APP_DOMAIN/api/media
IMAGE_MAX_SIZE_MB=20
VIDEO_MAX_SIZE_MB=150

# اترك S3 فارغًا عند استخدام local.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# اختيارية؛ استعادة كلمة المرور بالبريد لن ترسل رسالة قبل ضبط SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURE=false
