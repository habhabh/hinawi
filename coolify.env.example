# هذه القيم مخصصة لـ docker-compose.coolify.yml.
# انسخ الأسماء إلى Environment Variables في Coolify ولا ترفع القيم الحقيقية إلى GitHub.

APP_URL=https://YOUR_APP_DOMAIN
APP_IMAGE=ghcr.io/habhabh/hinawi:latest
SUPER_ADMIN_NAME=مدير النظام
SUPER_ADMIN_EMAIL=admin@example.com

DB_POOL_MAX=10
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=5000

# يولّد Coolify تلقائياً مستخدم وكلمة مرور PostgreSQL وأسرار التطبيق
# وكلمة مرور المدير عبر SERVICE_* magic variables في ملف Compose.
# اعرض SERVICE_PASSWORD_64_ADMIN من واجهة Coolify بعد النشر لتسجيل الدخول.

# الخيار الأبسط لأول نشر: local مع Persistent Volume على /data/media.
STORAGE_DRIVER=local
MEDIA_ROOT=/data/media
MEDIA_PUBLIC_BASE_URL=https://YOUR_APP_DOMAIN/api/media
IMAGE_MAX_SIZE_MB=20
VIDEO_MAX_SIZE_MB=150

# اترك S3 فارغًا عند استخدام local.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# اختيارية؛ استعادة كلمة المرور بالبريد لن ترسل رسالة قبل ضبط SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURE=false
